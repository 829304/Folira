{
  "name": "folira-monorepo",
  "version": "0.1.0",
  "description": "Folira monorepo root",
  "private": true,
  "homepage": "https://github.com/829304/Folira",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "bundle-size": "tsx scripts/bundle-size.ts",
    "test": "pnpm --filter folira test",
    "test:unit": "pnpm --filter folira test:unit",
    "typecheck": "pnpm --filter folira typecheck",
    "typecheck:watch": "pnpm --filter folira typecheck:watch",
    "check": "pnpm lint && pnpm typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1",
      "jsdom>lru-cache": "^11.3.5",
      "marked": "18.1.3",
      "mermaid>marked": "16.4.2"
    }
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-vue": "^10.9.2",
    "license-checker": "^25.0.1",
    "neostandard": "^0.13.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
