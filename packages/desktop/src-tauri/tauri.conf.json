{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folira",
  "version": "0.1.0",
  "identifier": "com.folira.app",
  "build": {
    "beforeDevCommand": "pnpm run tauri:dev-renderer",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm run tauri:build-renderer",
    "frontendDist": "../out-tauri/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Folira",
        "width": 1200,
        "height": 800,
        "minWidth": 550,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#282828",
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "dmg"],
    "resources": {
      "../static/locales/*.json": "locales/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A lightweight, cross-platform WYSIWYG Markdown editor",
    "longDescription": "Folira is a minimal, elegant Markdown editor built on Tauri 2 with the Muya engine. It keeps MarkText's WYSIWYG editing and focuses on a small install, fast startup and careful typography.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdwn", "mdtxt", "mdtext", "text", "txt"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {}
}
